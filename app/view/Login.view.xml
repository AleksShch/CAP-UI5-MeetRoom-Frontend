<mvc:View controllerName="rsvroom.controller.Login" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
  <VBox>
    <core:Fragment fragmentName="rsvroom.fragment.PageHeading" type="XML"/>
    <VBox class="card accountForm">
      <VBox visible="{page>/profile}">
        <VBox class="field">
          <Label text="{i18n>employee}" labelFor="profile"/>
          <Select id="profile" width="100%" selectedKey="{page>/userID}" items="{page>/profiles}">
            <core:Item key="{page>ID}" text="{page>label}"/>
          </Select>
        </VBox>
        <Text text="{page>/profileHint}" visible="{= !(${page>/profiles} || []).length }"/>
        <Button text="{i18n>retry}" visible="{= !(${page>/profiles} || []).length }" press=".onRetry"/>
      </VBox>
      <VBox visible="{= !${page>/profile} }">
        <VBox class="field">
          <Label text="{i18n>email}" labelFor="email"/>
          <Input id="email" type="Email" width="100%" required="true" value="{page>/email}"/>
        </VBox>
        <VBox class="field">
          <Label text="{i18n>password}" labelFor="password"/>
          <Input
            id="password"
            type="Password"
            width="100%"
            required="true"
            maxLength="256"
            value="{page>/password}"
            submit=".onSubmit"
          />
        </VBox>
        <VBox class="field" visible="{page>/setup}">
          <Label text="{i18n>setupToken}" labelFor="token"/>
          <Input id="token" type="Password" width="100%" value="{page>/token}"/>
          <Text text="{i18n>setupTokenHint}"/>
        </VBox>
      </VBox>
      <MessageStrip text="{page>/error}" type="Error" showIcon="true" visible="{= !!${page>/error} }"/>
      <Button
        text="{page>/submitText}"
        type="Emphasized"
        enabled="{= !${page>/busy} &amp;&amp; (!${page>/profile} || !!(${page>/profiles} || []).length) }"
        press=".onSubmit"
      />
    </VBox>
  </VBox>
</mvc:View>
