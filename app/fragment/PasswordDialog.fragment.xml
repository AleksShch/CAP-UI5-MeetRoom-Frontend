<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="dialog" title="{dialog>/heading}" contentWidth="28rem" class="formDialog" afterClose=".onAfterClose">
    <content>
      <VBox class="dialogFields">
        <VBox class="field" visible="{dialog>/own}">
          <Label text="{i18n>currentPassword}" labelFor="current"/>
          <Input id="current" type="Password" width="100%" maxLength="256" value="{dialog>/current}"/>
        </VBox>
        <VBox class="field">
          <Label text="{i18n>newPassword}" labelFor="password"/>
          <Input id="password" type="Password" width="100%" maxLength="256" value="{dialog>/password}"/>
        </VBox>
        <VBox class="field">
          <Label text="{i18n>confirmPassword}" labelFor="confirmation"/>
          <Input id="confirmation" type="Password" width="100%" maxLength="256" value="{dialog>/confirmation}"/>
        </VBox>
        <Text text="{i18n>passwordHint}" class="muted"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>save}" type="Emphasized" press=".onSavePassword"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onClose"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
