<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog
    id="dialog"
    title="{i18n>configureAreaBooking}"
    contentWidth="30rem"
    stretch="{dialog>/mobile}"
    class="formDialog"
    afterClose=".onAfterClose"
  >
    <content>
      <VBox class="dialogFields">
        <Text text="{i18n>areaSetupHint}" class="infoText"/>
        <VBox class="field">
          <Label text="{i18n>linkedResource}" labelFor="resource"/>
          <Select id="resource" width="100%" selectedKey="{dialog>/resourceID}" items="{dialog>/resources}">
            <core:Item key="{dialog>ID}" text="{dialog>name}"/>
          </Select>
        </VBox>
        <VBox visible="{= !${dialog>/resourceID} }">
          <VBox class="field">
            <Label text="{i18n>name}" labelFor="name"/>
            <Input id="name" value="{dialog>/name}" required="true" maxLength="200"/>
          </VBox>
          <VBox class="field">
            <Label text="{i18n>code}" labelFor="code"/>
            <Input id="code" value="{dialog>/code}" required="true" maxLength="40"/>
          </VBox>
          <VBox class="field">
            <Label text="{i18n>type}" labelFor="type"/>
            <Select id="type" width="100%" selectedKey="{dialog>/type}" items="{dialog>/types}" change=".onAreaType">
              <core:Item key="{dialog>ID}" text="{dialog>name}"/>
            </Select>
          </VBox>
          <VBox class="field">
            <Label text="{i18n>capacity}" labelFor="capacity"/>
            <StepInput
              id="capacity"
              min="1"
              max="10000"
              width="100%"
              value="{dialog>/capacity}"
              enabled="{= ${dialog>/type} === 'ROOM' }"
            />
          </VBox>
        </VBox>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>save}" type="Emphasized" enabled="{= !${dialog>/busy} }" press=".onSaveArea"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onClose"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
