<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="dialog" title="{i18n>account}" contentWidth="27rem" class="formDialog" afterClose=".onAfterClose">
    <content>
      <VBox class="dialogFields">
        <Text text="{dialog>/user/displayName}"/>
        <Text text="{dialog>/user/email}"/>
        <Text text="{dialog>/roleText}"/>
        <Button text="{i18n>changePassword}" press=".onPassword"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>signOut}" press=".onSignOut"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>close}" press=".onClose"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
