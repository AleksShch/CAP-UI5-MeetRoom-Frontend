<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="dialog" title="{i18n>displayLink}" contentWidth="34rem" class="formDialog" afterClose=".onAfterClose">
    <content>
      <VBox class="dialogFields">
        <Text text="{i18n>tokenNote}" class="infoText"/>
        <TextArea value="{dialog>/url}" editable="false" width="100%" rows="4"/>
        <Link text="{i18n>open}" href="{dialog>/url}" target="_blank"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>copyLink}" press=".onCopyLink"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>close}" press=".onClose"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
